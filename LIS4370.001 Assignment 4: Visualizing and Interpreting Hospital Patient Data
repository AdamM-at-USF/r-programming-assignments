# ------------------------------------------------------------------------------
# 1. Data Preparation and Cleaning
# ------------------------------------------------------------------------------

# Define the vectors as specified
Frequency     <- c(0.6, 0.3, 0.4, 0.4, 0.2, 0.6, 0.3, 0.4, 0.9, 0.2)
BloodPressure <- c(103, 87, 32, 42, 59, 109, 78, 205, 135, 176)
FirstAssess   <- c(1, 1, 1, 1, 0, 0, 0, 0, NA, 1)    # bad=1, good=0
SecondAssess  <- c(0, 0, 1, 1, 0, 0, 1, 1, 1, 1)    # low=0, high=1
FinalDecision <- c(0, 1, 0, 1, 0, 1, 0, 1, 1, 1)    # low=0, high=1

# Construct the initial data frame
df_hosp <- data.frame(
  Frequency, 
  BloodPressure, 
  FirstAssess,
  SecondAssess, 
  FinalDecision, 
  stringsAsFactors = FALSE
)

# Inspect dataset summary before cleaning
summary(df_hosp)

# Remove rows containing NA values (drops row 9 where FirstAssess is NA)
df_hosp <- na.omit(df_hosp)

# Verify NA removal
summary(df_hosp)


# ------------------------------------------------------------------------------
# 2. Basic Visualizations: Boxplots & Histograms
# ------------------------------------------------------------------------------

# --- Boxplots ---

# 1. Blood Pressure by First MD Assessment
png("boxplot_first_assess.png", width = 800, height = 600)
boxplot(
  BloodPressure ~ FirstAssess,
  data = df_hosp,
  names = c("Good", "Bad"),
  ylab = "Blood Pressure",
  xlab = "First Assessment",
  main = "BP by First MD Assessment",
  col = c("lightblue", "salmon")
)
dev.off()

# 2. Blood Pressure by Second MD Assessment
png("boxplot_second_assess.png", width = 800, height = 600)
boxplot(
  BloodPressure ~ SecondAssess,
  data = df_hosp,
  names = c("Low", "High"),
  ylab = "Blood Pressure",
  xlab = "Second Assessment",
  main = "BP by Second MD Assessment",
  col = c("lightgreen", "coral")
)
dev.off()

# 3. Blood Pressure by Final Decision
png("boxplot_final_decision.png", width = 800, height = 600)
boxplot(
  BloodPressure ~ FinalDecision,
  data = df_hosp,
  names = c("Low", "High"),
  ylab = "Blood Pressure",
  xlab = "Final Decision",
  main = "BP by Final Decision",
  col = c("lightskyblue", "darksalmon")
)
dev.off()


# --- Histograms ---

# 1. Histogram of Visit Frequency
png("histogram_frequency.png", width = 800, height = 600)
hist(
  df_hosp$Frequency,
  breaks = seq(0, 1, by = 0.1),
  xlab = "Visit Frequency",
  main = "Histogram of Visit Frequency",
  col = "plum",
  border = "black"
)
dev.off()

# 2. Histogram of Blood Pressure
png("histogram_blood_pressure.png", width = 800, height = 600)
hist(
  df_hosp$BloodPressure,
  breaks = 8,
  xlab = "Blood Pressure",
  main = "Histogram of Blood Pressure",
  col = "lightgray",
  border = "black"
)
dev.off()

