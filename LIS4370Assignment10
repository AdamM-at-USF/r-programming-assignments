# ------------------------------------------------------------------------------
# Package Initialization & Build Commands
# ------------------------------------------------------------------------------
library(devtools)

# 1. Create the R package directory structure
create("Friedman")

# 2. Set working directory to package root
setwd("Friedman")

# 3. Overwrite the DESCRIPTION file
description_content <- 'Package: Friedman
Title: Tools for Nonparametric Statistical Analysis and Data Mining
Version: 0.0.0.9000
Authors@R: person("Adam", "Margolis", email = "adammargolis@usf.edu", role = c("aut", "cre"))
Description: Provides simple utility functions for running non-parametric statistical tests, calculating rank-based metrics, and preparing data pipelines for predictive analysis.
Depends: R (>= 3.1.2)
Imports: 
    ggplot2,
    dplyr
License: CC0
LazyData: true
URL: https://github.com/AdamM-at-USF/r-programming-assignments/Friedman
BugReports: https://github.com/AdamM-at-USF/r-programming-assignments/Friedman/issues
'

writeLines(description_content, con = "DESCRIPTION")

# 4. Check for errors/warnings and build package bundle
check()
build()

