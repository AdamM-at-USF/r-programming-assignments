# --- Task 3: Explore S3 vs. S4 ---

# 1. S3 Object Example & Generic Dispatch
s3_obj <- list(name = "Myself", age = 29, GPA = 3.5)
class(s3_obj) <- "student_s3"

# Define a generic print method for student_s3
print.student_s3 <- function(x, ...) {
  cat("S3 Student Profile:\n")
  cat("  Name:", x$name, "\n")
  cat("  Age :", x$age, "\n")
  cat("  GPA :", x$GPA, "\n")
}

# Test S3 generic dispatch
print(s3_obj)


# 2. S4 Class & Object Example & Generic Dispatch
setClass(
  Class = "student_s4",
  slots = c(
    name = "character",
    age = "numeric",
    GPA = "numeric"
  )
)

s4_obj <- new("student_s4", name = "Myself", age = 29, GPA = 3.5)

# Define a generic show/print method for student_s4
setMethod("show", signature = "student_s4", function(object) {
  cat("S4 Student Profile:\n")
  cat("  Name:", object@name, "\n")
  cat("  Age :", object@age, "\n")
  cat("  GPA :", object@GPA, "\n")
})

# Test S4 generic dispatch
s4_obj
